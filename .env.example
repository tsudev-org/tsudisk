# ============================================================
# .env.example - MAU bien moi truong. KHONG chua gia tri that.
# TsuDisk la phan mem desktop chay offline: KHONG can bien moi truong nao de chay.
# Cac bien duoi day chi dung cho website (disk.tsudev.com) va CI.
# ============================================================

APP_NAME=tsudisk
APP_ENV=development
APP_URL=https://disk.tsudev.com

# Dong bo bo quy uoc trung tam (repo Public, khong can token).
TSUDEV_STANDARDS_REF=v3.6.0

# Trien khai website: dung `npx wrangler login` tren may, KHONG dat token vao day.
# CLOUDFLARE_API_TOKEN=
