---
// Trang /security/: bằng chứng tin cậy tự kiểm chứng được (phiếu 20261125-SEC2, mẫu thống nhất mục 2 phiếu gốc).
// Mỗi mục có liên kết tới trang kết quả của bên thứ ba + ngày đo; dữ liệu: docs/security/trust.json (src/lib/tin-cay.ts).
// Chính sách đầy đủ ở SECURITY.md trên GitHub; cơ chế bảo vệ dữ liệu đĩa ở /an-toan/.
import TaiLieu from '../components/TaiLieu.astro';
import { REPO, REPO_URL } from '../lib/noi-dung';
import { BANG_CHUNG, CAP_NHAT, CHUA_CO, ngayVn } from '../lib/tin-cay';
const ngoai = { target: '_blank', rel: 'noopener noreferrer' };
const mucLuc = [
  { id: 'bao-lo-hong', ten: 'Báo lỗ hổng' },
  { id: 'bang-chung', ten: 'Bằng chứng' },
  { id: 'tu-kiem', ten: 'Tự kiểm bản tải về' },
  { id: 'chua-co', ten: 'Chưa có, không áp dụng' },
];
---
<TaiLieu tieuDe="Bảo mật và tin cậy" moTa="Bằng chứng tin cậy của TsuDisk mà bạn tự kiểm được: điểm Observatory, SSL Labs, Scorecard, Best Practices, VirusTotal, chứng thực build và cách báo lỗ hổng." duongDan="/security/" mucLuc={mucLuc}>
  <h1>Bảo mật và tin cậy</h1>
  <p>Trang này chỉ liệt kê những gì bạn tự kiểm được: mỗi mục có liên kết tới trang kết quả do bên thứ ba lưu trữ và
    ngày đo. Điểm chưa cao vẫn ghi đúng số. Số liệu cập nhật ngày {ngayVn(CAP_NHAT)}. Cách TsuDisk bảo vệ dữ liệu trên
    đĩa ở <a href="/an-toan/">Cơ chế an toàn</a>; chính sách đầy đủ ở
    <a href={`${REPO_URL}/blob/main/SECURITY.md`} {...ngoai}>SECURITY.md ↗</a>.</p>

  <h2 id="bao-lo-hong">Báo lỗ hổng</h2>
  <ul>
    <li>Thư: <a href="mailto:security@tsudev.com">security@tsudev.com</a></li>
    <li>Báo riêng tư trên GitHub: <a href={`${REPO_URL}/security/advisories/new`} {...ngoai}>tạo báo cáo lỗ hổng ↗</a></li>
    <li>Phản hồi trong vòng 7 ngày. Xin đừng công khai lỗ hổng trước khi có bản sửa.</li>
    <li>Thông tin máy đọc: <a href="/.well-known/security.txt">security.txt</a> (RFC 9116).</li>
  </ul>

  <h2 id="bang-chung">Bằng chứng</h2>
  <div class="bang bang--bang-chung">
    <table>
      <thead><tr><th scope="col">Bằng chứng</th><th scope="col">Kết quả</th><th scope="col">Ngày đo</th><th scope="col">Kiểm chứng</th></tr></thead>
      <tbody>
        {BANG_CHUNG.map((b) => (
          <tr>
            <th scope="row">{b.ten}{b.ghi_chu && <p class="bang__ghi-chu">{b.ghi_chu}</p>}</th>
            <td data-nhan="Kết quả">{b.ket_qua}</td>
            <td data-nhan="Ngày đo">{ngayVn(b.ngay_do)}</td>
            <td data-nhan="Nguồn"><a href={b.lien_ket} {...ngoai} aria-label={`Kiểm chứng ${b.ten} (mở trang bên thứ ba)`}>Kiểm chứng ↗</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="tu-kiem">Tự kiểm bản tải về</h2>
  <p>Mỗi bản phát hành trên <a href={`${REPO_URL}/releases/latest`} {...ngoai}>GitHub Releases ↗</a> kèm
    <code>SHA256SUMS.txt</code> (ký Sigstore), chứng thực nguồn gốc build và SBOM. So mã băm của tệp đã tải với dòng
    tương ứng; lệch thì đừng chạy. Hướng dẫn đầy đủ ở <a href="/tai-ve/#kiem-tra">Tải về</a>.</p>
  <pre tabindex="0"><code>{`# PowerShell
Get-FileHash .\\tsudisk_<phiên bản>_windows-x64-portable.exe -Algorithm SHA256
gh attestation verify .\\tsudisk_<phiên bản>_windows-x64-portable.exe --repo ${REPO}`}</code></pre>

  <h2 id="chua-co">Chưa có, không áp dụng</h2>
  <ul>
    {CHUA_CO.map((c) => (
      <li><strong>{c.ten}</strong>: {c.ly_do}{c.lien_ket && <> (<a href={c.lien_ket} {...ngoai}>xem trạng thái ↗</a>)</>}</li>
    ))}
  </ul>
</TaiLieu>
