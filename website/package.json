{
  "name": "tsudisk-website",
  "private": true,
  "type": "module",
  "description": "Trang sản phẩm disk.tsudev.com (Astro, trang tĩnh, không JavaScript phía trình duyệt)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-dist.mjs",
    "test:worker": "node --test worker/chuan-hoa-url.test.mjs",
    "preview": "astro preview",
    "deploy": "npm run test:worker && npm run build && wrangler deploy && node scripts/the-deploy.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "brand": "node scripts/brand-assets.mjs",
    "check:bieu-tuong": "node scripts/check-bieu-tuong.mjs",
    "check:knip": "knip",
    "check:toc-do": "node scripts/check-toc-do.mjs"
  },
  "dependencies": {
    "astro": "7.4.13",
    "marked": "18.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "knip": "6.45.1",
    "playwright": "1.65.1",
    "sharp": "0.35.5",
    "wrangler": "4.165.0"
  }
}
