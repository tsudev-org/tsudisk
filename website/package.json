{
  "name": "tsudisk-website",
  "private": true,
  "type": "module",
  "description": "Trang sản phẩm disk.tsudev.com (Astro, trang tĩnh, không JavaScript phía trình duyệt)",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-dist.mjs",
    "test:worker": "node --test worker/chuan-hoa-url.test.mjs",
    "preview": "astro preview",
    "deploy": "npm run test:worker && npm run build && wrangler deploy",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "brand": "node scripts/brand-assets.mjs"
  },
  "dependencies": {
    "astro": "7.4.7",
    "marked": "18.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "playwright": "1.64.1",
    "wrangler": "4.158.0"
  }
}
